# ============================================================
# MoNa-pi Aliases Extension
#
# 2026-06-22 리팩터: 더 이상 vla-*/mona-*를 여기서 재정의하지 않는다.
# MoNaVLA의 .vla_aliases가 mona-<name>() 디스패처를 갖고 있고,
# "mona-<name> --pi ..."가 호출되면 같은 이름의 _monapi_<name>() hook을
# typeset -f로 찾아서 그대로 위임한다(없으면 경고만 출력하고 끝).
#
# 그래서 이 파일이 할 일은 _monapi_<name>() 함수만 정의하는 것 — vla-*를
# unalias/재정의하지 않는다. 이렇게 하면 MoNaVLA 쪽(.vla_aliases)이
# vla-server 같은 걸 나중에 어떻게 바꾸든(예: manage_api_server.sh로
# 확장) 이 파일을 다시 고칠 필요가 없다(모듈화 — 서로의 "기존 동작"을
# 베껴 적지 않고, 진짜 구현은 각자 자기 쪽에만 둔다).
#
# 사용: mona-cd --pi / mona-server --pi ... / mona-help --pi 등
# (vla-cd --pi 등 vla-* 쪽도 동일하게 동작 — .vla_aliases에서 같은
# _mona_dispatch를 타도록 만들어둠)
#
# Source 순서: .zshrc 맨 끝, .vla_aliases 이후 (위치는 그대로 유지)
# ============================================================

export MONA_PI_ROOT="/home/soda/MoNa-pi"

_monapi_cd() { cd "$MONA_PI_ROOT"; }

_monapi_collect() {
    echo "[MoNa-pi] 키보드 수집기 시작 (Ramp 가감속)"
    cd "$MONA_PI_ROOT" && python3 -m collect.keyboard_collector "$@"
}

_monapi_collect_ros() {
    echo "[MoNa-pi] ROS2 토픽 레코더 시작"
    cd "$MONA_PI_ROOT" && python3 collect/ros2_recorder.py "$@"
}

_monapi_server() {
    echo "[MoNa-pi] 추론 서버 시작 (Flow Matching, FastAPI)"
    cd "$MONA_PI_ROOT" && python3 inference/server.py "$@"
}

_monapi_inference() {
    echo "[MoNa-pi] ROS2 컨트롤러 노드 시작"
    source /opt/ros/humble/setup.bash 2>/dev/null
    cd "$MONA_PI_ROOT" && python3 robot/ros2_controller.py "$@"
}

_monapi_train() {
    local config="${1:-configs/train.yaml}"
    echo "[MoNa-pi] 학습 시작: $config"
    cd "$MONA_PI_ROOT" && python3 training/train.py --config "$config"
}

_monapi_eval() {
    local ckpt="${1:-checkpoints/best}"
    echo "[MoNa-pi] 오프라인 평가: $ckpt"
    cd "$MONA_PI_ROOT" && python3 training/evaluate.py --config configs/train.yaml --ckpt "$ckpt"
}

_monapi_analyze() {
    echo "[MoNa-pi] 액션 분포 분석"
    cd "$MONA_PI_ROOT" && python3 scripts/analyze_actions.py "$@"
}

_monapi_env() {
    echo "=========================================="
    echo "MoNa-pi Environment"
    echo "=========================================="
    echo "  MONA_PI_ROOT  = $MONA_PI_ROOT"
    echo "  Python        = $(python3 --version 2>&1)"
    echo "  CUDA          = $(python3 -c 'import torch; print(torch.cuda.get_device_name(0))' 2>/dev/null || echo 'N/A')"
    echo "  Dataset v5    = /home/soda/MoNaVLA/ROS_action/mobile_vla_dataset_v5/"
    echo "  Config        = $MONA_PI_ROOT/configs/train.yaml"
    echo "  Inference     = http://localhost:8080"
    echo "=========================================="
}

_monapi_close() {
    echo "[MoNa-pi] 프로세스 종료 중..."
    pkill -f "inference/server.py"   2>/dev/null
    pkill -f "robot/ros2_controller" 2>/dev/null
    pkill -f "collect/keyboard_collector" 2>/dev/null
    echo "MoNa-pi 프로세스 종료 완료"
}

_monapi_help() {
    cat << 'EOF'
==========================================
MoNa-pi Commands (mona-<cmd> --pi)
==========================================
[환경/이동]
  mona-cd --pi              MoNa-pi 디렉토리로 이동
  mona-env --pi             MoNa-pi 환경 변수 확인

[데이터 수집]
  mona-collect --pi [args]      키보드 수집기 (Ramp 가감속)
  mona-collect-ros --pi [args]  ROS2 토픽 레코더
    예) mona-collect --pi --output /data/ep001.h5 --task "장애물 회피"

[학습]
  mona-train --pi [config]  학습 시작 (기본: configs/train.yaml)
  mona-eval --pi [ckpt]     오프라인 평가 (기본: checkpoints/best)

[추론 서버]
  mona-server --pi [args]   FastAPI 추론 서버 시작 (Flow Matching)

[로봇 제어]
  mona-inference --pi [args] ROS2 컨트롤러 노드 시작

[분석/유틸]
  mona-analyze --pi          액션 분포 히스토그램
  mona-close --pi            MoNa-pi 프로세스 전체 종료

[경로]
  MONA_PI_ROOT = $MONA_PI_ROOT
==========================================
EOF
}

# mona-help는 MoNaVLA 쪽에서 배포 전용 커맨드로 이미 점유 중이라(--pi 분기
# 안 됨) 직접 보고 싶으면: zsh -c 'source ~/MoNa-pi/.mona_pi_aliases; _monapi_help'
